# ─────────────────────────────────────────────────────────────────────────────
# SPORTX API — environment configuration
# Copy to .env and fill in. NEVER commit .env. Every value here stays on the server;
# none of it is ever sent to the customer or admin frontends.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime: development | test | production
NODE_ENV=development
# Port the API listens on. Do NOT set PORT on Railway — the platform injects it.
# Local only:
PORT=4000
# Public URL of this API (used in links and docs).
# Production: https://vigilant-respect-production-14a3.up.railway.app
API_BASE_URL=http://localhost:4000
# Storefront and admin origins. Only these (plus CORS_EXTRA_ORIGINS) may call the API from a browser.
# Production storefront: https://sportx-djibouti-production.up.railway.app
# Production admin:      https://illustrious-enthusiasm-production-6248.up.railway.app
FRONTEND_URL=http://localhost:5173
ADMIN_FRONTEND_URL=http://localhost:5174
# Optional comma-separated extra allowed origins (e.g. a staging storefront).
CORS_EXTRA_ORIGINS=
# Number of reverse proxies in front of the API (1 on Render/Railway/behind Nginx) so client IPs and rate limits are correct.
TRUST_PROXY=0
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ─── Database (Supabase PostgreSQL) ─────────────────────────────────────────
# Supabase dashboard → Project Settings → Database → Connection string (URI).
# Use the session pooler (port 5432) or a direct connection; the API uses transactions and row locks.
DATABASE_URL=postgres://postgres:YOUR-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres
# true for Supabase / any hosted Postgres; false for a local database.
DATABASE_SSL=true
# Connection pool size per API instance. Use 1 with the embedded local DB (npm run db:local).
DATABASE_POOL_MAX=10

# ─── Supabase (Auth + Storage) ──────────────────────────────────────────────
# Supabase dashboard → Project Settings → API.
# Use the JWT keys (anon public / service_role), NOT only the new sb_publishable_ / sb_secret_ keys.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Public anon JWT (eyJhbGciOi…). Used server-side for sign-in / password-recovery calls.
SUPABASE_ANON_KEY=
# SECRET. Service-role JWT (eyJhbGciOi…, role=service_role). Server-side only — never expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket for product/category/brand/avatar images (created by migration 20260925000800).
SUPABASE_STORAGE_BUCKET=sportx-media

# ─── Authentication ────────────────────────────────────────────────────────
# supabase = credentials in Supabase Auth (production). local = scrypt hashes in Postgres (development/tests only).
AUTH_PROVIDER=supabase
# SECRET. Signs the API's short-lived access tokens. At least 32 random characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Access-token lifetime (seconds). Refresh tokens rotate on every use.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Refresh-token cookie. In production keep COOKIE_SECURE=true. If the API and the frontends are on
# different sites (not just different subdomains), set COOKIE_SAMESITE=none.
# Railway (api + storefront + admin on different *.up.railway.app hosts): COOKIE_SAMESITE=none
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# e.g. .sportx.dj to share the cookie across api.sportx.dj and sportx.dj; leave empty for host-only.
COOKIE_DOMAIN=
# Require customers to confirm their email before signing in.
EMAIL_VERIFICATION_REQUIRED=false

# ─── Email ─────────────────────────────────────────────────────────────────
# console = log emails (development) | smtp | resend
EMAIL_PROVIDER=console
EMAIL_FROM=SPORTX <no-reply@your-domain>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# SECRET
SMTP_PASSWORD=
SMTP_SECURE=false
# SECRET (when EMAIL_PROVIDER=resend)
RESEND_API_KEY=

# ─── Payments ──────────────────────────────────────────────────────────────
# Comma-separated, in priority order: cash_on_delivery, stripe, mock (mock = test gateway; refused in production).
PAYMENT_PROVIDERS=cash_on_delivery
# SECRET. Stripe secret key (sk_live_… / sk_test_…). Card data never touches this server.
STRIPE_SECRET_KEY=
# SECRET. Signing secret of the Stripe webhook pointing at {API_BASE_URL}/api/v1/payments/webhook/stripe
STRIPE_WEBHOOK_SECRET=
# SECRET (optional). HMAC secret for the mock provider's webhooks in development.
MOCK_PAYMENT_WEBHOOK_SECRET=

# ─── Shipping ──────────────────────────────────────────────────────────────
# internal = rates from the shipping_methods table (editable in the admin).
SHIPPING_PROVIDER=internal

# ─── File storage ──────────────────────────────────────────────────────────
# supabase = Supabase Storage (production) | local = ./uploads served at /uploads (development)
STORAGE_PROVIDER=supabase
LOCAL_UPLOAD_DIR=uploads
# Maximum upload size in bytes (default 5 MB).
UPLOAD_MAX_BYTES=5242880

# ─── Background jobs ───────────────────────────────────────────────────────
# Runs recurring jobs (expire unpaid orders, prune sessions). Enable on exactly one instance.
JOBS_ENABLED=true

# ─── Seed (development / demo only) ────────────────────────────────────────
# Optional accounts created by `npm run db:seed`. Leave empty in production; use `npm run create-admin` instead.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_DEMO_CUSTOMER_EMAIL=
SEED_DEMO_CUSTOMER_PASSWORD=
