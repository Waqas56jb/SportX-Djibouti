# SPORTX Admin — public (browser-exposed) configuration only.
# Anything prefixed with VITE_ is bundled into the client. NEVER put secrets here
# (payment secret keys, service-role keys, SMTP passwords). Those belong on the server.

# Local development: point at a local API. Production builds use .env.production
# (https://lucky-celebration-production-b94f.up.railway.app) and never localhost.
VITE_API_URL=http://localhost:4000
