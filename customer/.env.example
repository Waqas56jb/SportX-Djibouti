# SPORTX storefront — public configuration (bundled into the browser; never put secrets here).
# Base URL of the SPORTX API (without /api/v1), e.g. https://api.sportx.dj
# Local development: http://localhost:4000 · Production (Railway): see .env.production
# (https://lucky-celebration-production-b94f.up.railway.app). A VITE_API_URL service variable overrides it.
VITE_API_URL=http://localhost:4000
# Public site origin, used for canonical URLs.
VITE_SITE_URL=http://localhost:5173
# Optional: Stripe publishable key (pk_…) when the API has the Stripe provider enabled.
# Card entry then uses Stripe Elements; card data never reaches the SPORTX API.
VITE_STRIPE_PUBLISHABLE_KEY=
