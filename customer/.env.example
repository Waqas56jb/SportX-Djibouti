# SPORTX storefront — public configuration (bundled into the browser; never put secrets here).
# Local development: point at a local API. Production builds use .env.production
# (https://vigilant-respect-production-14a3.up.railway.app) and never localhost.
VITE_API_URL=http://localhost:4000
# Public site origin, used for canonical URLs.
VITE_SITE_URL=http://localhost:5173
# Optional: Stripe publishable key (pk_…) when the API has the Stripe provider enabled.
# Card entry then uses Stripe Elements; card data never reaches the SPORTX API.
VITE_STRIPE_PUBLISHABLE_KEY=
